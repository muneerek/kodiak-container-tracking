{
  "ConnectionStrings": {
    "TrackingDatabase": "Host=localhost;Port=5432;Database=kodiak_container_tracking;Username=postgres"
  },
  "UniqueCodes": {
    "EmployeePrefix": "EMP-",
    "ConsigneePrefix": "CON-",
    "ShipperPrefix": "SHP-",
    "Padding": 6
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Kodiak.ContainerTracking",
    "Audience": "kodiak-container-tracking",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Bootstrap": {
    "Enabled": false,
    "UserName": "superadmin",
    "FirstName": "Super",
    "LastName": "Admin",
    "EmailId": null,
    "InitialPassword": ""
  },
  "PhotoStorage": {
    "RootPath": "App_Data/Photos",
    "MaxFileBytes": 2097152
  },
  "ContainerStorage": {
    "RootPath": "App_Data/ContainerAttachments",
    "MaxFileBytes": 10485760,
    "MaxFilesPerContainer": 20
  }
}
